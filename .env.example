# Hackathon key. Sent only from the server as the X-Api-Key header.
# Base URL is fixed to https://hackathon.api.qloo.com — staging and production reject this key.
QLOO_API_KEY=

# Optional. When set, the planner asks this model which Qloo calls to make.
# Recommendations still come from Qloo. If this is empty, a rule-based planner runs the same calls.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
